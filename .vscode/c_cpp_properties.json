{
    "configurations": [
        {
            "name": "Pintos",
            "includePath": [
                "${workspaceFolder}/pintos/src",
                "${workspaceFolder}/pintos/src/lib",
                "${workspaceFolder}/pintos/src/lib/kernel"
            ],
            "defines": [
                "THREADS"
            ],
            "compilerPath": "/usr/bin/gcc",
            "compilerArgs": [
                "-nostdinc",
                "-m32"
            ],
            "cStandard": "gnu99",
            "intelliSenseMode": "linux-gcc-x86"
        }
    ],
    "version": 4
}
